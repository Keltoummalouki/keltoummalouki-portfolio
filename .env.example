# =============================================================================
# Environment contract — TEMPLATE (names only, NEVER real values).
#
# Setup:  copy this file to `.env.local` and fill in real values.
#         `.env.local` is gitignored and must never be committed.
#
# Golden rule:
#   - NEXT_PUBLIC_*  -> embedded in the browser bundle. Public by design.
#   - everything else -> SERVER-ONLY. Must be read only from server modules
#     (Server Components, Server Actions, Route Handlers, `server-only` files).
#     A server-only secret must NEVER be given a NEXT_PUBLIC_ prefix, and must
#     NEVER be imported into a Client Component.
# =============================================================================

# -----------------------------------------------------------------------------
# PUBLIC (safe to expose to the browser)
# -----------------------------------------------------------------------------

# Supabase project URL. Public.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/publishable key. Public — Row Level Security is the real
# authorization boundary, not this key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile site key. Public — rendered into the form widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# OPTIONAL. Umami analytics (cookie-less, no personal data). Public: the ID ends
# up in the page HTML. Leave empty to disable analytics entirely: no script is
# loaded and the CSP does not allow Umami. Set it at BUILD time (the CSP is
# built from it), then redeploy. Only the production hostname reports, so local
# dev and preview deployments are never counted.
# From Umami: Settings > Websites > Edit > Tracking code (`data-website-id`).
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# OPTIONAL. Tracker script for a self-hosted Umami, e.g.
# https://stats.example.com/script.js. Leave empty for Umami Cloud.
NEXT_PUBLIC_UMAMI_SCRIPT_URL=

# OPTIONAL. Canonical site origin used for canonical URLs, hreflang, Open Graph,
# JSON-LD, sitemap.xml and robots.txt. No trailing slash. Leave empty in
# production to use the default https://www.keltoummalouki.com. Only override it
# if the site moves to another domain — every canonical URL follows this value.
# (Indexing is controlled separately: Vercel preview/development deployments are
# always `noindex` and get a blocking robots.txt, based on VERCEL_ENV.)
NEXT_PUBLIC_SITE_URL=

# -----------------------------------------------------------------------------
# SERVER-ONLY (secrets — never sent to the browser)
# -----------------------------------------------------------------------------

# Supabase service-role key. BYPASSES RLS. Server-only. If this ever reaches the
# browser bundle, treat it as a credential leak and rotate it immediately.
SUPABASE_SERVICE_ROLE_KEY=

# Secret salt used to hash visitor IPs for contact/lead rate limiting. Server-only.
# Keep stable, or existing IP hash buckets will no longer match.
IP_HASH_SECRET=

# Cloudflare Turnstile secret key. Used only for server-side token verification.
TURNSTILE_SECRET_KEY=

# OPTIONAL search-engine ownership verification (server-only; not secrets, but
# read only in the root layout metadata). When set, the matching
# <meta name="google-site-verification"> / <meta name="msvalidate.01"> tag is
# rendered on every page; when empty, no tag is emitted.
#
# Preferred: verify a Google Search Console *Domain property* via a DNS TXT
# record at your DNS provider — it covers https/http and www/non-www at once and
# needs no code. Use GOOGLE_SITE_VERIFICATION only for a URL-prefix property
# (paste the `content` value of the HTML-tag method, not the whole tag).
# After verifying, submit https://www.keltoummalouki.com/sitemap.xml.
GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools HTML-tag value (`msvalidate.01` content). Alternatively,
# import the site from Google Search Console or verify via DNS (CNAME) in Bing.
BING_SITE_VERIFICATION=

# =============================================================================
# CSP status (already applied in next.config.ts `cspHeader`)
#
#   - M3 (Supabase client):
#       connect-src  += https://*.supabase.co  wss://*.supabase.co
#       img-src      += https://*.supabase.co        (Storage public images)
#   - M7 (Turnstile on the contact form):
#       script-src   += https://challenges.cloudflare.com
#       frame-src     = https://challenges.cloudflare.com
#       connect-src  += https://challenges.cloudflare.com
#   - M7 (EmailJS removed): https://api.emailjs.com dropped from connect-src.
#   - Analytics (only while NEXT_PUBLIC_UMAMI_WEBSITE_ID is set):
#       script-src   += https://cloud.umami.is   (or the self-hosted origin)
#       connect-src  += https://gateway.umami.is (or the self-hosted origin)
#
# Turnstile is OPTIONAL: with no NEXT_PUBLIC_TURNSTILE_SITE_KEY the widget is not
# rendered, and with no TURNSTILE_SECRET_KEY the server verifier is bypassed, so
# the contact form works in local dev without any Turnstile keys.
# =============================================================================
